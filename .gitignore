.DS_Store

# Local-only reference archive (558MB, not needed for development)
ARCHIVE/

# Godot (generated/editor cache)
.godot/
*.import

# Godot export/build outputs (if created)
export/
build/

# Logs/temp files from tooling
*.log
*.tmp

# Backup artifacts (regenerable via tools/persistent/BACKUP.py)
BACKUP_*.ZIP
BACKUP.ZIP

# Large binary files (design assets - use external storage)
*.psd
*.psb
*.ai
*.mov
*.mp4
*.wav
*.flac

# PNG assets — all provisional/generated; committed only when art is final
# Generators (tools/asset_generation/*.py) reproduce everything on demand.
*.png
*.svg

# Python cache
__pycache__/
*.pyc
.pytest_cache/

# Editor temp files
.vscode/
*.swp
*.swo
.aider*
session_*.zip
REFERENCES/
# ASSETS/ contents stay local (heavy binaries) — but the art specifications
# manual is a versioned project document (Director decision 2026-07-16).
# Note: `ASSETS/*` (not `ASSETS/`) because git cannot re-include a file
# whose parent directory is excluded.
ASSETS/*
!ASSETS/ART_SPECIFICATIONS.md

# Screenshots/ — Director's manual Shift+P captures stay local, never
# committed. Screenshots/history/*.png is the exception: SCREENSHOT-HOOK-01's
# pre-commit auto-capture, which IS meant to be versioned (see
# OPERATOR_CONTEXT.md "Auto-Screenshot History"). Editor-generated .import
# sidecars stay ignored even inside history/ — the global `*.import` rule
# above only applies until a more specific `!` re-includes the directory, so
# this is scoped to *.png specifically rather than re-including everything.
Screenshots/*
!Screenshots/history/
!Screenshots/history/*.png

# D33 Part 2 — golden-fixture PNGs for the GDScript<->Python decal compositor
# equality proof (decal_compositor_equality_selftest.gd). Frozen ground truth
# generated once by tools/asset_generation/d33_part2_fixture_gen.py from the
# real Python compositor, not provisional art — regenerating them at test
# time would make the equality proof circular. See
# PROMPTS/D33_RUNTIME_DECAL_COMPOSITING.md §5 Part 2.
!godot/scripts/tools/fixtures/d33_part2/*.png

# D33 Part 3b — same as above, for the HalfVoxelCompositor equality proof
# (half_voxel_compositor_equality_selftest.gd), generated by
# tools/asset_generation/d33_part3b_fixture_gen.py.
!godot/scripts/tools/fixtures/d33_part3b/*.png

# D33 Part 3c — floor-sunk case, same reasoning, generated by
# tools/asset_generation/d33_part3c_fixture_gen.py.
!godot/scripts/tools/fixtures/d33_part3c/*.png

# D33 Part 3d — ceiling carve case, same reasoning, generated by
# tools/asset_generation/d33_part3d_fixture_gen.py.
!godot/scripts/tools/fixtures/d33_part3d/*.png
# SCREENSHOT-HOOK-03: .gdignore makes the Godot editor skip the whole
# Screenshots/ tree (no .import sidecars, no resource scan) while the files
# stay on disk for the capture/diff tooling, which uses absolute paths.
!Screenshots/.gdignore

# SCREENSHOT-HOOK-02: local session on/off state for auto-capture — not a
# project artifact, never shared via commits (see screenshot_toggle.py).
tools/persistent/.screenshot_session
