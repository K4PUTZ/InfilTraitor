; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the file format allows this.

config_version=5

[application]

config/name="INFILTRAITOR"
config/description="Mobile turn-based stealth tactics — Godot 4 isometric 2.5D"
config/version="0.1.0-pre-alpha"
run/main_scene="res://godot/scenes/game/room.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="mobile"

[layer_names]

2d_render/layer_1="floor"
2d_render/layer_2="structure"
2d_render/layer_3="entities"
2d_render/layer_4="ui"
