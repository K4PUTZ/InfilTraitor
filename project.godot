; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="INFILTRAITOR"
config/description="Mobile turn-based stealth tactics — Godot 4 isometric 2.5D"
config/version="0.1.0-pre-alpha"
run/main_scene="res://godot/scenes/game/room.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"

[layer_names]

2d_render/layer_1="floor"
2d_render/layer_2="structure"
2d_render/layer_3="entities"
2d_render/layer_4="ui"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
