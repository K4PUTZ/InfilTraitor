; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="INFILTRAITOR"
config/description="Mobile turn-based stealth tactics — Godot 4 isometric 2.5D"
config/version="0.1.0-pre-alpha"
run/main_scene="res://godot/scenes/game/room.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

VersionInfo="*res://godot/scripts/systems/version_info.gd"
Localization="*res://godot/scripts/systems/localization/localization_manager.gd"
Registries="*res://godot/scripts/systems/registries_autoload.gd"

[display]

