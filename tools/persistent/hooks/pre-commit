#!/usr/bin/env bash
# INFILTRAITOR pre-commit hook — three gates + one best-effort capture:
#   1. Inviolable-rule guard (check_invariants.py) — blocks code that breaks the
#      architecture rules in OPERATOR_CONTEXT.md. Cannot auto-fix; aborts.
#   2. CODEMAP freshness gate (gen_codemap.py) — blocks a stale generated doc.
#      Auto-regenerates + stages it, then aborts so you can review and re-commit.
#   3. GDScript compile gate (project_lint.py) — blocks any commit while a
#      script in godot/scripts/ has a real compile error (autoload-context
#      headless false positives are whitelisted inside the tool).
#   + SCREENSHOT-HOOK-01/02 (best-effort, never blocks, gated OFF by
#     default): when enabled, auto-captures a real screenshot of the
#     last-worked-on map into Screenshots/history/ so a visual claim always
#     has a same-commit, unattended reference image to check against.
#     OFF by default (routine commits skip it instantly) — turn on for a
#     visual-heavy phase with `python3 tools/persistent/screenshot_toggle.py
#     --on` (--off to revert), or set INFILTRAITOR_SCREENSHOT_ONCE=1 for a
#     single commit. See auto_screenshot.py, screenshot_toggle.py, and
#     OPERATOR_CONTEXT.md's "Auto-Screenshot History" section.
#
# No gate lets a bad commit reach history.
#
# Install (one-time, from repo root):
#   git config core.hooksPath tools/persistent/hooks
# (or copy this file to .git/hooks/pre-commit and chmod +x)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHECK="$REPO_ROOT/tools/persistent/check_invariants.py"
GEN="$REPO_ROOT/tools/persistent/gen_codemap.py"
LINT="$REPO_ROOT/tools/persistent/project_lint.py"
DOCS="$REPO_ROOT/tools/persistent/update_docs.py"

# ── Gate 1: inviolable-rule guard ───────────────────────────────────────────
if [ -f "$CHECK" ]; then
    if ! python3 "$CHECK"; then
        echo ""
        echo "✗ Commit aborted: architecture rule violation (see above)."
        echo "  Fix the code, then re-run your commit."
        exit 1
    fi
fi

# ── Gate 1.5: AUTO doc headers (Version/Updated/Branch) ────────────────────
# Regenerates the AUTO blocks in current_state.md and OPERATOR_CONTEXT.md and
# stages them silently — no abort: a date/version header needs no review, and
# aborting every commit for it would train people to bypass the hook. This is
# what keeps the context headers truthful no matter how a commit is made
# (the old path only ran inside push.sh, which direct `git push` bypasses —
# headers rotted for weeks). Decision: Director, 2026-07-10.
if [ -f "$DOCS" ]; then
    if python3 "$DOCS" > /dev/null 2>&1; then
        git add "$REPO_ROOT/docs/production/current_state.md" \
                "$REPO_ROOT/tools/persistent/OPERATOR_CONTEXT.md" \
                "$REPO_ROOT/tools/persistent/CODEMAP.md" 2>/dev/null || true
    else
        echo "⚠ update_docs.py failed — committing with possibly stale AUTO headers (not blocking)"
    fi
fi

# ── Gate 2: CODEMAP freshness ───────────────────────────────────────────────
if [ -f "$GEN" ]; then
    if ! python3 "$GEN" --check; then
        echo ""
        echo "CODEMAP.md was stale. Regenerating and staging it now..."
        python3 "$GEN"
        git add "$REPO_ROOT/tools/persistent/CODEMAP.md"
        echo ""
        echo "✗ Commit aborted: CODEMAP.md has been regenerated + staged."
        echo "  Review the change, then re-run your commit."
        exit 1
    fi
fi

# ── Gate 3: GDScript compile check ──────────────────────────────────────────
if [ -f "$LINT" ]; then
    if ! python3 "$LINT"; then
        echo ""
        echo "✗ Commit aborted: real GDScript compile error(s) (see above)."
        echo "  Fix the scripts, then re-run your commit."
        exit 1
    fi
fi

# ── SCREENSHOT-HOOK-01: best-effort auto-capture, never blocks ─────────────
# Runs only after the compile gate passes (no point capturing a broken build).
# Any failure here (Godot missing, capture timeout, no map yet loaded) prints
# a warning and the commit proceeds — this is support tooling, not a
# correctness gate, per the Director's explicit ratification (2026-07-11).
# Screenshots/ lives at repo root, NOT under REFERENCES/ (REFERENCES/ is
# entirely gitignored — an earlier version of this line pointed there and
# silently no-op'd every `git add`, so screenshots were captured on disk but
# never actually entered any commit; fixed 2026-07-11, same session).
AUTO_SCREENSHOT="$REPO_ROOT/tools/persistent/auto_screenshot.py"
if [ -f "$AUTO_SCREENSHOT" ]; then
    if python3 "$AUTO_SCREENSHOT"; then
        git add "$REPO_ROOT/Screenshots/history" 2>/dev/null || true
    else
        echo "⚠ auto-screenshot capture failed or skipped — committing without a fresh capture (not blocking)"
    fi
fi

exit 0
