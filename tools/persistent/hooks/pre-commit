#!/usr/bin/env bash
# INFILTRAITOR pre-commit hook — freshness gate for the generated CODEMAP.
#
# Blocks the commit if tools/persistent/CODEMAP.md is out of date with the
# GDScript source. To remove the friction of a manual regen, on a stale doc it
# regenerates and stages the file for you, then aborts so you can review and
# re-commit. The commit itself never goes through with a stale codemap.
#
# Install (one-time, from repo root):
#   git config core.hooksPath tools/persistent/hooks
# (or copy this file to .git/hooks/pre-commit and chmod +x)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
GEN="$REPO_ROOT/tools/persistent/gen_codemap.py"

if [ ! -f "$GEN" ]; then
    # Generator absent — nothing to enforce.
    exit 0
fi

if python3 "$GEN" --check; then
    exit 0
fi

echo ""
echo "CODEMAP.md was stale. Regenerating and staging it now..."
python3 "$GEN"
git add "$REPO_ROOT/tools/persistent/CODEMAP.md"
echo ""
echo "✗ Commit aborted: CODEMAP.md has been regenerated + staged."
echo "  Review the change, then re-run your commit."
exit 1
